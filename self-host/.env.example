# Copy to self-host/.env on the VPS (git-ignored).
DB_PASSWORD=
BETTER_AUTH_SECRET=        # openssl rand -base64 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
INNGEST_EVENT_KEY=         # openssl rand -hex 16
INNGEST_SIGNING_KEY=       # openssl rand -hex 32
