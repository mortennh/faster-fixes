# Copy to self-host/.env on the VPS (git-ignored).
DB_PASSWORD=
BETTER_AUTH_SECRET=        # openssl rand -base64 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
INNGEST_EVENT_KEY=         # openssl rand -hex 16
INNGEST_SIGNING_KEY=       # openssl rand -hex 32
# Linear/Slack/Jira token ciphers (openssl rand -hex 32 each) — required even if unused
LINEAR_TOKEN_ENCRYPTION_KEY=
SLACK_TOKEN_ENCRYPTION_KEY=
JIRA_TOKEN_ENCRYPTION_KEY=
# true after the first account(s) exist — closes registration
DISABLE_SIGN_UP=false
